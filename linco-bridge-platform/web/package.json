{
  "name": "linco-bridge-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "vite",
    "build:h5": "node scripts/with-prod-env.mjs vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss}\" \"*.{ts,js,mjs,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css,scss}\" \"*.{ts,js,mjs,json}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "dev:mp-weixin": "node scripts/report-removed-platform.js mp-weixin",
    "build:mp-weixin": "node scripts/report-removed-platform.js mp-weixin",
    "build:web": "node scripts/with-prod-env.mjs vite build",
    "dev": "vite",
    "build": "node scripts/with-prod-env.mjs vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build:android && npx cap sync",
    "android:add": "npx cap add android",
    "android:dev": "npm run cap:sync && npx cap open android",
    "android:build": "npm run cap:sync && cd android && gradlew.bat :app:assembleDebug",
    "android:check": "node scripts/check-android-env.cjs",
    "build:android": "vite build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "highlight.js": "^11.11.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "sass": "^1.89.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^5.2.8",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.10"
  }
}
